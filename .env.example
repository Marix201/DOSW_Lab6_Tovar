# Copy to .env (git-ignored) and fill in your own values. Never commit real secrets.

# Required: HS256 signing key, at least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Optional: database (defaults match the Docker command in the README)
# DB_URL=jdbc:postgresql://localhost:5432/todo_db
# DB_USERNAME=todo_user
# DB_PASSWORD=

# Optional: allowed frontend origin for CORS
# CORS_ALLOWED_ORIGIN=http://localhost:5173

# Optional, LOCAL DEVELOPMENT ONLY: creates an ADMIN account at startup when both are set
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
